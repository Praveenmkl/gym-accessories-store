      "destination": "https://gym-accessories-store-admin.vercel.app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gym-accessories-store-vbfj6w14j-praveen-kalansooriyas-projects.vercel.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://gym-accessories-store-vbfj6w14j-praveen-kalansooriyas-projects.vercel.app/:path*"
    }
  ]
}